# Dependencies / build
node_modules/
*.o

# Built extension objects (keep committed dist/ binaries)
*.o
!dist/**/*.so
!dist/**/*.dll
!dist/**/*.dylib

# Ignore stray binaries outside dist/
*.so
*.dll
*.dylib
!dist/**/*.so
!dist/**/*.dll
!dist/**/*.dylib

# REAPER local userdata (never commit)
.reaper-resource/
*.RPP-bak
*.reapeaks

# Unpacked stock theme images (regenerate with tools/unpack_default_theme.sh)
vendor/themes/
**/Default_7.0_unpacked/
**/Default_6.0_unpacked/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Test output
/tmp/
*.log
