# OSC pattern config file — ReaProfessor
# Copy to REAPER resource OSC/ folder (tools/link_to_reaper.sh does this).
# Enable: Preferences → Control/OSC/web → add device → ReaProfessor pattern config.
#
# Native REAPER OSC can trigger numbered actions. For LP2-style paths without
# stable script action IDs, also run Scripts/ReaProfessor/control_service.lua and
# send ExtState oneshots from a small UDP bridge, OR use /action with registered
# ReaProfessor scripts after loading them once in the Actions list.

DEVICE_TRACK_COUNT 16
DEVICE_SEND_COUNT 0
DEVICE_RECEIVE_COUNT 0
DEVICE_FX_COUNT 8
DEVICE_FX_PARAM_COUNT 16
DEVICE_FX_INST_PARAM_COUNT 0
DEVICE_MARKER_COUNT 0
DEVICE_REGION_COUNT 0

REAPER_TRACK_FOLLOWS REAPER
DEVICE_TRACK_FOLLOWS DEVICE
DEVICE_TRACK_BANK_FOLLOWS DEVICE
DEVICE_FX_FOLLOWS DEVICE

# Generic action trigger (use command IDs from Actions list after loading scripts)
ACTION i/action s/action/str t/action/@ f/action/@/cc

# Documentation of logical ReaProfessor addresses (handled by control_service):
# /CueLists/Go
# /CueLists/Back
# /CueLists/GoTo
# /GlobalSnapshots/Recall
# /GlobalSnapshots/RecallName
# /GlobalSnapshots/Mode          # bypass | params | full
# /Command/Channels/Create      # args: count, mode
# /Command/Channels/Mode        # same_strip | double_patch
# /Command/Channels/ApplyRecordSafe
# /Command/View/LiveMode
